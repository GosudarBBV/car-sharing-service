# MySQL конфігурація
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=car_sharing_db
MYSQL_USER=car_user
MYSQL_PASSWORD=car_password
MYSQL_LOCAL_PORT=3307     # локальний порт для підключення з ПК
MYSQL_DOCKER_PORT=3306    # порт всередині контейнера

# Spring Boot
SPRING_LOCAL_PORT=8081    # порт, на якому доступне API ззовні
SPRING_DOCKER_PORT=8080   # порт всередині контейнера

# Debug
DEBUG_PORT=5005
